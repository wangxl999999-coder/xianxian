.favorites-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.goods-list {
  
}

.goods-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.goods-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-price {
  display: flex;
  align-items: baseline;
}

.price-current {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B35;
  margin-right: 15rpx;
}

.price-original {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-distance {
  font-size: 24rpx;
  color: #999;
}

.delete-btn {
  font-size: 24rpx;
  color: #FF6B35;
  padding: 10rpx 20rpx;
  border: 1rpx solid #FF6B35;
  border-radius: 30rpx;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-home-btn {
  background: #FF6B35;
  color: #fff;
  border-radius: 50rpx;
  padding: 15rpx 60rpx;
  font-size: 28rpx;
  display: inline-block;
  border: none;
}
