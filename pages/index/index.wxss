.index-container {
  padding-bottom: 120rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx;
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

.category-scroll {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.category-list {
  display: flex;
  padding: 0 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  padding: 10rpx;
  min-width: 100rpx;
}

.category-item:last-child {
  margin-right: 0;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

.category-item.active .category-name {
  color: #FF6B35;
  font-weight: bold;
}

.category-item.active::after {
  content: '';
  display: block;
  width: 40rpx;
  height: 6rpx;
  background: #FF6B35;
  border-radius: 3rpx;
  margin-top: 10rpx;
}

.sort-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-right: 1rpx solid #eee;
}

.sort-item:last-child {
  border-right: none;
}

.sort-item.active {
  color: #FF6B35;
  font-weight: bold;
}

.goods-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}

.goods-item {
  width: 50%;
  padding: 10rpx;
  box-sizing: border-box;
}

.goods-image {
  position: relative;
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.goods-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.goods-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: rgba(255, 107, 53, 0.9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.goods-info {
  padding: 20rpx 10rpx;
}

.goods-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.goods-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 15rpx;
}

.price-current {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B35;
  margin-right: 10rpx;
}

.price-original {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.seller-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.seller-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #f5f5f5;
}

.seller-name {
  font-size: 22rpx;
  color: #666;
  margin-right: 8rpx;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.credit-tag {
  font-size: 18rpx;
  color: #FF6B35;
  background: #FFEDE5;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.goods-distance {
  font-size: 20rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
