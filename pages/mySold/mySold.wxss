.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.order-list {
  
}

.order-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 26rpx;
  color: #666;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.goods-info {
  display: flex;
  margin-bottom: 20rpx;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.goods-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B35;
}

.buyer-info {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.info-label {
  color: #999;
}

.info-value {
  flex: 1;
  margin-right: 20rpx;
}

.info-time {
  color: #999;
}

.order-actions {
  text-align: right;
}

.action-btn {
  display: inline-block;
  padding: 12rpx 40rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: none;
  margin: 0;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
