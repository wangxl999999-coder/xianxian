<view class="address-edit-container">
  <view class="form-item">
    <text class="label">收货人</text>
    <input class="input" placeholder="请输入收货人姓名" value="{{formData.name}}" bindinput="onInput" data-field="name" />
  </view>

  <view class="form-item">
    <text class="label">手机号码</text>
    <input class="input" placeholder="请输入手机号码" value="{{formData.phone}}" bindinput="onInput" data-field="phone" type="number" maxlength="11" />
  </view>

  <view class="form-item" bindtap="chooseRegion">
    <text class="label">所在地区</text>
    <view class="region-value">
      <text wx:if="{{formData.province}}">{{formData.province}} {{formData.city}} {{formData.district}}</text>
      <text class="placeholder" wx:else>请选择省/市/区</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="form-item">
    <text class="label">详细地址</text>
    <textarea class="textarea" placeholder="请输入详细地址，如街道、门牌号等" value="{{formData.detail}}" bindinput="onInput" data-field="detail" maxlength="100" auto-height />
  </view>

  <view class="form-item switch-item">
    <text class="label">设为默认地址</text>
    <switch checked="{{formData.isDefault}}" bindchange="onSwitchChange" color="#FF6B35" />
  </view>

  <view class="save-wrapper safe-area-bottom">
    <button class="save-btn btn-primary btn-large" bindtap="saveAddress">
      保存地址
    </button>
  </view>
</view>
