.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.profile-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8E53 100%);
  padding: 60rpx 30rpx;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 30rpx;
  background: #fff;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
}

.credit-tag {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 15rpx;
}

.user-stats {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.user-stats text {
  margin-right: 30rpx;
}

.edit-btn {
  font-size: 40rpx;
  color: #fff;
}

.credit-card {
  background: #fff;
  margin: -30rpx 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.credit-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
}

.credit-progress {
  margin-bottom: 25rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 15rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #52c41a 0%, #FF6B35 100%);
  border-radius: 6rpx;
}

.credit-levels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

.credit-desc {
  display: flex;
  flex-wrap: wrap;
}

.credit-desc text {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 15rpx;
  margin-bottom: 10rpx;
}

.menu-section {
  background: #fff;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.tag {
  font-size: 22rpx;
  color: #52c41a;
  background: #E8F7E0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

.arrow {
  font-size: 32rpx;
  color: #999;
}

.logout-section {
  padding: 40rpx 20rpx;
}

.logout-btn {
  background: #fff;
  color: #FF4D4F;
  border: 2rpx solid #FF4D4F;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}
