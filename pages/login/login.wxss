.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8E53 100%);
  padding: 100rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-content {
  background: #fff;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
}

.feature-list {
  display: flex;
  justify-content: space-around;
  margin-bottom: 60rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #666;
}

.agreement-tip {
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.agreement-label checkbox {
  transform: scale(0.8);
  margin-right: 10rpx;
}

.link {
  color: #FF6B35;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.btn-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.login-btn[disabled] {
  opacity: 0.5;
}

.login-tip {
  text-align: center;
  font-size: 22rpx;
  color: #999;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 40rpx 30rpx;
}

.auth-tip {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
}

.auth-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.auth-item:last-child {
  border-bottom: none;
}

.auth-label {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.auth-desc {
  font-size: 24rpx;
  color: #999;
}

.auth-btn {
  background: #FF6B35;
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
  padding: 10rpx 30rpx;
  line-height: 1.5;
}

.auth-btn.verified {
  background: #52c41a;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.skip-btn,
.confirm-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  border: none;
  background: #fff;
  border-radius: 0;
}

.confirm-btn {
  color: #FF6B35;
  font-weight: bold;
  border-left: 1rpx solid #eee;
}
