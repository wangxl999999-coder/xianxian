<view class="container">
  <view class="order-list" wx:if="{{orderList.length > 0}}">
    <view class="order-item" wx:for="{{orderList}}" wx:key="id">
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status" style="color: {{item.status === 1 ? '#52c41a' : '#FF6B35'}};">
          {{item.statusName}}
        </text>
      </view>
      
      <view class="goods-info" bindtap="goDetail" data-id="{{item.goodsId}}">
        <image class="goods-image" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="goods-detail">
          <view class="goods-title">{{item.title}}</view>
          <view class="goods-price">¥{{item.price}}</view>
        </view>
      </view>

      <view class="seller-info">
        <text class="info-label">卖家：</text>
        <text class="info-value">{{item.sellerName}}</text>
        <text class="info-time">{{item.dealTime}}</text>
      </view>

      <view class="order-actions" wx:if="{{item.status === 1 && !item.isRated}}">
        <button class="action-btn" bindtap="goRate" data-id="{{item.id}}">去评价</button>
        <button class="action-btn contact" bindtap="contactSeller" data-id="{{item.id}}">联系卖家</button>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{orderList.length === 0}}">
    <image src="/images/empty.png"></image>
    <view class="empty-text">暂无买入记录</view>
    <button class="go-btn" bindtap="goHome">去逛逛</button>
  </view>
</view>
