.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.goods-list {
  
}

.goods-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
}

.goods-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.status-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 20rpx;
}

.top-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8E53);
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
}

.polish-tag {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
}

.goods-stats {
  margin: 10rpx 0;
}

.stat-item {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B35;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.publish-time {
  font-size: 24rpx;
  color: #999;
}

.action-buttons {
  display: flex;
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  margin-left: 10rpx;
}

.action-btn.edit {
  background: #E6F7FF;
  color: #1890FF;
}

.action-btn.delete {
  background: #FFF1F0;
  color: #FF4D4F;
}

.action-btn.mark {
  background: #F6FFED;
  color: #52C41A;
}

.action-btn.polish {
  background: #FFF7E6;
  color: #FA8C16;
}

.action-btn.polish.disabled {
  background: #f5f5f5;
  color: #999;
}

.action-btn.top {
  background: #E6F7FF;
  color: #1890FF;
}

.top-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 20rpx 30rpx 40rpx;
}

.top-list {
  
}

.top-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.top-item:last-child {
  border-bottom: none;
}

.top-info {
  
}

.top-duration {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.top-desc {
  font-size: 24rpx;
  color: #999;
}

.top-price {
  font-size: 36rpx;
  color: #FF6B35;
  font-weight: bold;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.publish-btn {
  background: #FF6B35;
  color: #fff;
  border-radius: 50rpx;
  padding: 15rpx 60rpx;
  font-size: 28rpx;
  display: inline-block;
  border: none;
}
