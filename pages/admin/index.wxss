.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #FF6B35, #FF8E53);
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.admin-info {
  display: flex;
  align-items: center;
}

.admin-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 20rpx;
}

.admin-detail {
  display: flex;
  flex-direction: column;
}

.admin-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.admin-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.logout-btn {
  padding: 12rpx 30rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.stats-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 50%;
  text-align: center;
  padding: 20rpx 0;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B35;
  margin-bottom: 10rpx;
}

.stat-item.warning .stat-value {
  color: #FF4D4F;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.menu-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.menu-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
}

.menu-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.menu-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  position: relative;
}

.icon-text {
  font-size: 48rpx;
}

.badge {
  position: absolute;
  top: -5rpx;
  right: -5rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #FF4D4F;
  color: #fff;
  font-size: 20rpx;
  border-radius: 18rpx;
  padding: 0 8rpx;
}

.menu-name {
  font-size: 26rpx;
  color: #666;
}
