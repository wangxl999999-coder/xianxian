<view class="container">
  <scroll-view class="status-tabs" scroll-x="true" show-scrollbar="false">
    <view class="tab-list">
      <view class="tab-item {{status === item.id ? 'active' : ''}}" wx:for="{{statusOptions}}" wx:key="id" bindtap="changeStatus" data-status="{{item.id}}">
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <view class="goods-list">
    <view class="goods-item" wx:for="{{goodsList}}" wx:key="id">
      <view class="goods-image" bindtap="viewDetail" data-id="{{item.id}}">
        <image src="{{item.cover}}" mode="aspectFill"></image>
        <view class="report-tag" wx:if="{{item.isReported}}">
          被举报{{item.reportCount}}次
        </view>
      </view>
      <view class="goods-info">
        <view class="goods-title" bindtap="viewDetail" data-id="{{item.id}}">{{item.title}}</view>
        <view class="goods-price">¥{{item.price}}</view>
        <view class="goods-meta">
          <text class="seller">发布者：{{item.sellerName}}</text>
          <text class="views">{{item.viewCount}}次浏览</text>
        </view>
        <view class="goods-footer">
          <text class="status-tag status-{{item.status}}">{{item.statusName}}</text>
          <view class="actions">
            <text class="action-btn" wx:if="{{item.status === 1}}" bindtap="takeOff" data-id="{{item.id}}">下架</text>
            <text class="action-btn warning" wx:if="{{item.status === 1 || item.status === 4}}" bindtap="deleteGoods" data-id="{{item.id}}">删除</text>
            <text class="action-btn success" wx:if="{{item.status === 3 || item.status === 5}}" bindtap="restore" data-id="{{item.id}}">恢复</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && goodsList.length > 0}}">
    <text>没有更多了</text>
  </view>

  <view class="empty" wx:if="{{goodsList.length === 0 && !loading}}">
    <text>暂无数据</text>
  </view>
</view>
