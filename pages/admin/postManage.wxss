.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.status-tabs {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.tab-list {
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  padding: 15rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  margin-right: 20rpx;
  white-space: nowrap;
}

.tab-item.active {
  background: #FF6B35;
  color: #fff;
  font-weight: bold;
}

.post-list {
  padding: 0 20rpx;
}

.post-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.type-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-right: 15rpx;
}

.type-1 {
  background: #FFF1F0;
  color: #FF6B35;
}

.type-2 {
  background: #F6FFED;
  color: #52C41A;
}

.type-3 {
  background: #E6F7FF;
  color: #1890FF;
}

.author-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.author-name {
  font-size: 24rpx;
  color: #666;
  margin-right: 15rpx;
}

.publish-time {
  font-size: 22rpx;
  color: #999;
}

.ban-tag {
  padding: 6rpx 16rpx;
  background: #FFF1F0;
  color: #FF4D4F;
  font-size: 20rpx;
  border-radius: 20rpx;
}

.post-content {
  margin-bottom: 15rpx;
}

.post-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-images {
  display: flex;
  margin-top: 15rpx;
}

.post-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  margin-right: 15rpx;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 15rpx;
  border-top: 1rpx solid #f5f5f5;
}

.post-stats {
  display: flex;
  align-items: center;
}

.stat {
  font-size: 24rpx;
  color: #999;
  margin-right: 30rpx;
}

.post-actions {
  
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.delete-btn {
  background: #FFF1F0;
  color: #FF4D4F;
}

.restore-btn {
  background: #F6FFED;
  color: #52C41A;
}

.loading, .no-more, .empty {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}
