.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.status-tabs {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.tab-list {
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  padding: 15rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  margin-right: 20rpx;
  white-space: nowrap;
}

.tab-item.active {
  background: #FF6B35;
  color: #fff;
  font-weight: bold;
}

.report-list {
  padding: 0 20rpx;
}

.report-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.report-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.report-type {
  display: flex;
  align-items: center;
}

.type-tag {
  padding: 6rpx 16rpx;
  background: #E6F7FF;
  color: #1890FF;
  font-size: 20rpx;
  border-radius: 20rpx;
  margin-right: 15rpx;
}

.reason-tag {
  padding: 6rpx 16rpx;
  background: #FFF7E6;
  color: #FA8C16;
  font-size: 20rpx;
  border-radius: 20rpx;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}

.status-1 {
  background: #FFF1F0;
  color: #FF4D4F;
}

.status-2 {
  background: #FFF7E6;
  color: #FA8C16;
}

.status-3 {
  background: #F6FFED;
  color: #52C41A;
}

.status-4 {
  background: #f5f5f5;
  color: #999;
}

.report-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.report-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.report-meta text {
  font-size: 24rpx;
  color: #666;
}

.report-time {
  font-size: 22rpx;
  color: #999;
}

.loading, .no-more, .empty {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.detail-section {
  margin-bottom: 25rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.section-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.section-value.target {
  font-weight: bold;
  color: #FF6B35;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.report-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  margin: 0 10rpx;
}

.reject-btn {
  background: #f5f5f5;
  color: #666;
}

.ban-btn {
  background: linear-gradient(135deg, #FF6B35, #FF8E53);
  color: #fff;
}
