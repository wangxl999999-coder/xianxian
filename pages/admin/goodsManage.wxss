.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.status-tabs {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.tab-list {
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  padding: 15rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  margin-right: 20rpx;
  white-space: nowrap;
}

.tab-item.active {
  background: #FF6B35;
  color: #fff;
  font-weight: bold;
}

.goods-list {
  padding: 0 20rpx;
}

.goods-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
}

.goods-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.report-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 6rpx 12rpx;
  background: #FF4D4F;
  color: #fff;
  font-size: 18rpx;
  border-radius: 20rpx;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B35;
  margin: 10rpx 0;
}

.goods-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.seller, .views {
  font-size: 22rpx;
  color: #999;
}

.goods-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-1 {
  background: #F6FFED;
  color: #52C41A;
}

.status-2 {
  background: #E6F7FF;
  color: #1890FF;
}

.status-3 {
  background: #f5f5f5;
  color: #999;
}

.status-4 {
  background: #FFF1F0;
  color: #FF4D4F;
}

.status-5 {
  background: #FFF1F0;
  color: #CF1322;
}

.actions {
  display: flex;
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-left: 15rpx;
  background: #E6F7FF;
  color: #1890FF;
}

.action-btn.warning {
  background: #FFF1F0;
  color: #FF4D4F;
}

.action-btn.success {
  background: #F6FFED;
  color: #52C41A;
}

.loading, .no-more, .empty {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}
