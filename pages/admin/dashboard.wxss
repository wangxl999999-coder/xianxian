.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.date-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 15rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  margin: 0 10rpx;
}

.tab-item.active {
  background: #FF6B35;
  color: #fff;
  font-weight: bold;
}

.stats-section {
  margin: 0 20rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.stat-card {
  width: calc(50% - 7.5rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-card.highlight {
  background: linear-gradient(135deg, #FFF5F0, #FFF);
}

.stat-card.warning {
  background: linear-gradient(135deg, #FFF1F0, #FFF);
}

.stat-icon {
  font-size: 48rpx;
  margin-bottom: 15rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B35;
  margin-bottom: 10rpx;
}

.stat-card.warning .stat-value {
  color: #FF4D4F;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.chart-section {
  margin: 0 20rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.chart-container {
  
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 300rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.chart-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  height: 100%;
}

.bar {
  width: 24rpx;
  border-radius: 12rpx 12rpx 0 0;
  position: absolute;
  bottom: 30rpx;
}

.goods-bar {
  background: linear-gradient(180deg, #FF6B35, #FF8E53);
  left: 10rpx;
}

.trades-bar {
  background: linear-gradient(180deg, #52C41A, #73D13D);
  right: 10rpx;
}

.bar-label {
  position: absolute;
  bottom: 0;
  font-size: 20rpx;
  color: #999;
}

.chart-legend {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 0 30rpx;
  font-size: 24rpx;
  color: #666;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.goods-dot {
  background: #FF6B35;
}

.trades-dot {
  background: #52C41A;
}

.category-section {
  margin: 0 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.category-list {
  
}

.category-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.category-item:last-child {
  border-bottom: none;
}

.category-info {
  width: 180rpx;
}

.category-name {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 5rpx;
}

.category-count {
  font-size: 22rpx;
  color: #999;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin: 0 20rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35, #FF8E53);
  border-radius: 8rpx;
}

.category-percent {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: bold;
  color: #FF6B35;
}
